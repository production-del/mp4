# Unleashed API credentials.
# Used by the /api/refresh-* routes (SOH, sales orders, assemblies) and
# any server code that hits the Unleashed REST API. Required.
UNLEASHED_API_ID=your-api-id
UNLEASHED_API_KEY=your-api-key

# OPTIONAL: Live demand data from a Google Sheet (Phase 4o).
# When set, the planner pulls monthly demand from this sheet on every
# page render instead of from data/demand.csv. The sheet must be shared
# as "Anyone with the link can view" — we use the public CSV-export
# endpoint (no API key needed). Sheet must have at minimum a
# "Product Code" column and an "AVE" column; see the existing demand.csv
# for the full layout the parser tolerates.
#
# To find the sheet ID and gid, open the sheet and look at the URL:
#   docs.google.com/spreadsheets/d/<SHEET_ID>/edit?gid=<GID>
GOOGLE_SHEETS_ID=your-sheets-id
DEMAND_SHEET_GID=0

# Google SSO via NextAuth.js (production access control).
# Restricts sign-in to @thebyroncoop.com email addresses. Get the OAuth
# client ID + secret from Google Cloud Console; set the redirect URI to
# https://<your-deployment>/api/auth/callback/google.
#
# AUTH_SECRET: any 32+ char random string (`openssl rand -base64 32`).
# AUTH_URL:    canonical site URL — defaults to the request host in dev,
#              but set explicitly in production to avoid redirect bugs.
AUTH_SECRET=your-random-32-char-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
AUTH_URL=http://localhost:3000

# Postgres connection for the shared plan-draft store. Either env var
# works — DATABASE_URL takes precedence. On Vercel this is typically
# set automatically when you connect a Vercel Postgres / Neon database
# to the project.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# All other planning inputs are local files in data/, no other env vars
# are read by the app:
#
#   data/demand.csv                          fallback monthly demand —
#                                            used when the sheet vars
#                                            above aren't configured or
#                                            the sheet fetch fails
#   data/kitchen capacity and family plans.xlsx
#                                            packaging stations, families,
#                                            kitchen processes, BOMS,
#                                            wastage rates, intermediates
#   data/raw-material-lead-times.json        per-material lead times +
#                                            vendor names (operator-edited)
#   data/product-overrides.json              per-product overrides (shelf
#                                            life, max batch — drawer-edited)
#   data/soh-cache.json                      SOH snapshot from Unleashed
#   data/sales-orders-cache.json             sales orders snapshot
#   data/assemblies-cache.json               kitchen assemblies snapshot
